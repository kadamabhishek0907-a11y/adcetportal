# Copy this file to .env and fill in your own keys.
# NEVER commit .env — it is ignored by git (see .gitignore).

# Get your Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Firecrawl API key at https://firecrawl.dev (Settings -> API Keys)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: which site to crawl when building the FAQ index.
# After first deploy, point this at YOUR Vercel URL so the bot learns
# from your own deployed site.
CRAWL_URL=https://adcetportal.vercel.app
